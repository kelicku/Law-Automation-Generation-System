# ── Database (PostgreSQL 16 / Supabase Postgres) ─────────────────────
# Owner: runs migrations only. Never used by the running web app.
DATABASE_OWNER_URL=postgres://aiip_owner:change-me@127.0.0.1:5435/aiip_demo
# Web application role (NOBYPASSRLS – every query is filtered by Row Level Security)
DATABASE_APP_URL=postgres://aiip_app:change-me@127.0.0.1:5435/aiip_demo
# System jobs role (collector, auth lookup, backup, demo reset). BYPASSRLS – server only.
DATABASE_WORKER_URL=postgres://aiip_worker:change-me@127.0.0.1:5435/aiip_demo

# ── Security ─────────────────────────────────────────────────────────
# 32+ random bytes (hex). Used to sign idempotency keys / hash identifiers.
SESSION_SECRET=
# Enables one-click demo login, persona switching and demo reset. Set to false in production.
DEMO_MODE=true
# Optional: require this code before the one-click demo login (recommended for public tunnels).
DEMO_ACCESS_CODE=

# ── AI ───────────────────────────────────────────────────────────────
# If unset, AI tasks run in clearly-labelled SIMULATION mode (deterministic, extractive).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# true: ignore the key and use simulation (used by the E2E test server)
AI_FORCE_SIMULATION=false

# ── Collector ────────────────────────────────────────────────────────
# true: also fetch the real public RSS feed(s) configured in src/lib/collector/connectors.ts
COLLECTOR_LIVE_RSS=false
